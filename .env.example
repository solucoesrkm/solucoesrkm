# ==============================================================================
# Solucoes RKM - Variaveis de Ambiente
# ==============================================================================
#
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env com valores reais!
#
# ==============================================================================

# ---- Banco de Dados (Turso - compartilhado com Tracka) ----
DATABASE_URL="libsql://seu-db.turso.io"
TURSO_AUTH_TOKEN="seu-token-turso"

# ---- App ----
NEXT_PUBLIC_APP_URL="https://tracka.solucoesrkm.com"  # URL do app Tracka (login, register, API publica)
NEXT_PUBLIC_SITE_URL="https://solucoesrkm.com"        # URL desta landing page (SEO, robots.txt, sitemap)
JWT_SECRET="gerar-com-node-crypto-randomBytes-32-hex"  # >=16 chars — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Integracao com o app Tracka (pricing) ----
# Enviada no header x-api-key para /api/public/plans. Sem ela, o pricing cai no
# fallback i18n (desatualizado). Gere no admin do Tracka -> Integracoes / API Keys.
# Detalhes: VERCEL_GUIDE.md secao 10.
TRACKA_LANDING_API_KEY=

# ---- Freshdesk (Opcional) ----
FRESHDESK_API_KEY=
FRESHDESK_DOMAIN=                                     # Ex: solucoesrkm.freshdesk.com - fallback do DB

# ---- Vercel Cron (para sync automatico com Freshdesk) ----
CRON_SECRET=
